    "@nx/node": "24.0.5",
    "@nx/web": "24.0.5",
    "@nx/webpack": "24.0.5",
    "@nx/workspace": "24.0.5",
    "@oxlint/plugins": "^1.91.0",
    "@playwright/test": "^1.64.1",
    "@swc/helpers": "~0.5.24",
    "@tailwindcss/vite": "^4.3.4",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "jest": "~30.5.2",
    "jest-environment-node": "~30.5.2",
    "jest-util": "~30.5.1",
    "nx": "24.0.5",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.2",
