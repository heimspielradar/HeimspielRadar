{
  "name": "@sundayleague/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve backend",
    "start:backend": "nx serve backend",
    "start:frontend": "nx serve frontend",
    "build": "nx run-many -t build",
    "build:backend": "nx build backend",
    "build:frontend": "nx build frontend",
    "test": "nx run-many -t test",
    "test:backend": "nx test backend",
    "test:e2e": "playwright test",
    "test:scripts": "bash scripts/spawn-remote-agent.test.sh",
    "agent:spawn": "bash scripts/spawn-remote-agent.sh",
    "screenshot": "node scripts/capture-pr-screenshot.mjs",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "tsc -p apps/backend/tsconfig.app.json --noEmit && tsc -p apps/backend/tsconfig.spec.json --noEmit",
    "typecheck:frontend": "tsc -p apps/frontend/tsconfig.json --noEmit && tsc -p apps/frontend/tsconfig.spec.json --noEmit",
    "lint": "nx run-many -t lint",
    "lint:oxlint": "oxlint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "docs:dbb": "node scripts/serve-docs.js",
    "docker:deploy-pi": "bash scripts/deploy-pi.sh",
    "release": "nx release",
    "release:dry-run": "nx release --dry-run",
    "lockfile:check": "npm ci --dry-run --ignore-scripts"
  },
  "private": true,
  "devDependencies": {
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.8",
